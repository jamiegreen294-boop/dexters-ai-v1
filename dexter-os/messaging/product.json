{
  "name": "Dexter Send",
  "version": "0.2.0",
  "mode": "one-way-notifications",
  "sender": "Dexters",
  "replies": false,
  "messageTypes": [
    "order-notification",
    "promotion"
  ],
  "freeDefaultChannels": [
    "loyalty-pwa-push",
    "customer-app-push",
    "dexter-os-push",
    "in-app-inbox",
    "web-push"
  ],
  "paidChannelsDefaultEnabled": false,
  "smsDefaultEnabled": false,
  "transactionalEvents": [
    "order-received",
    "order-accepted",
    "order-amended",
    "order-rejected",
    "preparing",
    "ready-for-collection",
    "collected"
  ],
  "promotionsRequireMarketingPreference": true,
  "notificationBranding": {
    "title": "Dexters",
    "icon": "Dexter logo"
  }
}
